# Copy this file to .env.local and fill in your key to enable AI card identification.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for card identification (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Fill these in to show live eBay listings on a card's page.
# Get keys at https://developer.ebay.com/ (Application Keys page).
# Start with the sandbox keyset — it returns eBay's fake test data, so
# "weird" results are expected until you have production keys approved.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=sandbox (default) or production

# Optional: your Amazon Associates tracking ID (e.g. "beefynukes-20").
# Adds your affiliate tag to the "Protect This Card" supply links.
# Sign up at https://affiliate-program.amazon.com/ — not a secret, safe to
# expose to the browser, which is why this is NEXT_PUBLIC_.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# Optional: PSA Public API token, for the "View Population on Cert Page"
# link's underlying lookup. Sign in/register at https://www.psacard.com/publicapi —
# note actual API access needs PSA to separately approve your account.
PSA_API_TOKEN=

# Required for the card library's data store (Neon Postgres).
# Create a free project at https://neon.tech — the connection string is
# shown on your project dashboard.
DATABASE_URL=

# Required for card photo storage (Cloudflare R2, S3-compatible).
# Create a bucket at https://dash.cloudflare.com (R2 in the sidebar), enable
# "Public Development URL" on it for R2_PUBLIC_URL, and create an R2 API
# token scoped to that bucket (Object Read & Write) for the rest.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
